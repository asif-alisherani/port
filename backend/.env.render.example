# =====================================================================
#  PRODUCTION env for Render  (Aiven MySQL + Supabase Storage)
#  Render → your service → Environment → "Add from .env" → paste this
#  (with your real values). Never commit the filled-in version.
# =====================================================================

# --- App ---------------------------------------------------------------
APP_NAME=Portfolio
APP_ENV=production
APP_DEBUG=false
# Generate on your PC:  cd backend && php artisan key:generate --show
APP_KEY=base64:PASTE_THE_GENERATED_KEY_HERE
# Must match your Render URL exactly (no trailing slash)
APP_URL=https://portfolio-api.onrender.com
# Where the React site is hosted (no trailing slash)
FRONTEND_URL=https://your-frontend-domain.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database: Aiven MySQL --------------------------------------------
# Aiven console → MySQL service → Overview → Connection information
DB_CONNECTION=mysql
DB_HOST=mysql-xxxxxxxx-yourname.aivencloud.com
DB_PORT=12345
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your-aiven-password
# Aiven requires SSL. Add a Render "Secret File" named aiven-ca.pem
# containing the Aiven CA certificate → it is mounted at this path:
MYSQL_ATTR_SSL_CA=/etc/secrets/aiven-ca.pem

# --- Sessions / cache / queue (stored in MySQL) -------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail (contact form notifications) ---------------------------------
# "log" = written to Render logs. Switch to smtp later if you want emails.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Portfolio
CONTACT_NOTIFY_EMAIL=sherani.asifali@gmail.com

# --- Media uploads: Supabase Storage (S3-compatible) -------------------
# Supabase → Storage → Settings (S3 connection) + S3 Access Keys
# Bucket must be PUBLIC.
MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=your-supabase-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=your-bucket-name
AWS_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
AWS_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/your-bucket-name
AWS_USE_PATH_STYLE_ENDPOINT=true

# Upload limits in KB (optional — these are the defaults)
UPLOAD_IMAGE_MAX_KB=10240
UPLOAD_VIDEO_MAX_KB=204800

# Run new migrations automatically on each deploy (default true)
RUN_MIGRATIONS=true
