APP_NAME="Asif Ali Sherani — Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Where the built React site lives (used for CORS + the "View site" link)
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite keeps local setup to zero steps. Swap to mysql/pgsql for production.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=portfolio
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
BCRYPT_ROUNDS=12

FILESYSTEM_DISK=public

# Contact form notifications
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@asifali.dev"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_NOTIFY_EMAIL=sheranil.asifa@gmail.com

# Seeded admin account (change before deploying)
ADMIN_EMAIL=admin@asifali.dev
ADMIN_PASSWORD=password
