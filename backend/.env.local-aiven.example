# =====================================================================
#  LOCAL env (your PC) talking to the SAME Aiven DB + Supabase bucket
#  as production. Copy to backend/.env and fill in.
#  Run with:  php artisan serve   → http://localhost:8000
#
#  ⚠ Anything you change locally changes the LIVE site (same database).
#  For safe experiments use the default SQLite/XAMPP .env instead.
# =====================================================================

APP_NAME=Portfolio
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:PASTE_THE_GENERATED_KEY_HERE
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Aiven MySQL ---------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql-xxxxxxxx-yourname.aivencloud.com
DB_PORT=12345
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your-aiven-password
# Path to the downloaded Aiven CA certificate on YOUR PC.
# Windows: use forward slashes, e.g. C:/Users/Asif/certs/aiven-ca.pem
MYSQL_ATTR_SSL_CA=C:/Users/YOUR_NAME/certs/aiven-ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Portfolio
CONTACT_NOTIFY_EMAIL=sherani.asifali@gmail.com

# --- Supabase Storage (same bucket as production) ------------------------
MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=your-supabase-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=your-bucket-name
AWS_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
AWS_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/your-bucket-name
AWS_USE_PATH_STYLE_ENDPOINT=true

# Seeder only (php artisan db:seed) — sets the admin login it creates
ADMIN_EMAIL=admin@asifali.dev
ADMIN_PASSWORD=change-me-to-something-strong
